# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing. The release keystore is the app's identity: lose it and no one who
# already installed it can ever update again, because Android refuses an
# update signed with a different key. It lives outside the repo, backed up,
# and key.properties only points at it.
*.jks
*.keystore
/android/key.properties
/android/local.properties

# Secrets. API keys belong in the host's environment (Vercel), never here.
.env
.env.*
!.env.example
/.vercel
